<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutomationSuite">

    <!-- Login/logout flow tests: extend BaseTest, need a fresh unauthenticated
         browser per method since they're testing the auth flow itself. -->
    <test name="AuthenticationTests">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.LogoutTest"/>
        </classes>
    </test>

    <!-- Already-authenticated dashboard management tests: extend AuthenticatedBaseTest,
         log in once per class and share that session across methods. -->
    <test name="DashboardManagementTests">
        <classes>
            <class name="tests.AddDashboardTest"/>
            <class name="tests.DeleteTest"/>
            <class name="tests.DashboardTest"/>
            <class name="tests.ManageDashboardTest"/>
        </classes>
    </test>

</suite>
